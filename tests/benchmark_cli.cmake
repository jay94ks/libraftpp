if(NOT DEFINED PROGRAM OR NOT DEFINED WORK_ROOT)
    message(FATAL_ERROR "benchmark program/work root required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(work "${WORK_ROOT}/benchmark-cli-${token}")
if(EXISTS "${work}")
    message(FATAL_ERROR "temporary benchmark path collision")
endif()
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/preserved" "unrelated data")
execute_process(COMMAND "${PROGRAM}" submit --dir "${work}" -b4096 --size=4096 --timeout 5000
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "benchmark failed: ${status}\n${errors}\n${output}")
endif()
string(JSON count LENGTH "${output}")
if(NOT count EQUAL 2)
    message(FATAL_ERROR "unexpected benchmark JSON shape: ${output}")
endif()
foreach(name IN ITEMS submit:4096 submit:write:4096)
    string(JSON value GET "${output}" "${name}" latency value)
    string(JSON lower GET "${output}" "${name}" latency lower_bound)
    string(JSON upper GET "${output}" "${name}" latency upper_bound)
    if(value LESS_EQUAL 0 OR lower GREATER value OR upper LESS value)
        message(FATAL_ERROR "invalid actual latency bounds: ${output}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" submit --dir "${work}" --buf 8
    RESULT_VARIABLE status OUTPUT_VARIABLE invalid ERROR_VARIABLE errors TIMEOUT 5)
if("${status}" STREQUAL "0" OR NOT "${invalid}" STREQUAL "")
    message(FATAL_ERROR "invalid input produced a measurement: ${invalid}")
endif()
execute_process(COMMAND "${PROGRAM}" unrecognized-command
    RESULT_VARIABLE status OUTPUT_VARIABLE invalid ERROR_VARIABLE errors TIMEOUT 5)
if("${status}" STREQUAL "0" OR NOT "${invalid}" STREQUAL "")
    message(FATAL_ERROR "unknown command produced a measurement: ${invalid}")
endif()
if(EXISTS "/dev/full")
    execute_process(COMMAND "${PROGRAM}" submit --dir "${work}" -b4096 -s4096 --timeout 5000
        RESULT_VARIABLE status OUTPUT_FILE "/dev/full" ERROR_VARIABLE errors TIMEOUT 15)
    if("${status}" STREQUAL "0" OR NOT errors MATCHES "write benchmark report failed")
        message(FATAL_ERROR "stdout failure reported as successful measurement: ${status} ${errors}")
    endif()
endif()
execute_process(COMMAND "${PROGRAM}" disk --help
    RESULT_VARIABLE status OUTPUT_VARIABLE help ERROR_VARIABLE errors TIMEOUT 5)
if(NOT "${status}" STREQUAL "0" OR NOT help MATCHES "block device")
    message(FATAL_ERROR "disk command/help unavailable: ${status} ${errors}")
endif()
execute_process(COMMAND "${PROGRAM}" disk --dir "${work}" --buf 513
    RESULT_VARIABLE status OUTPUT_VARIABLE invalid ERROR_VARIABLE errors TIMEOUT 5)
if("${status}" STREQUAL "0" OR NOT "${invalid}" STREQUAL "")
    message(FATAL_ERROR "invalid disk buffer produced a measurement")
endif()
execute_process(COMMAND "${PROGRAM}" disk --dir "${work}" -b512 -s512 --timeout 5000
    RESULT_VARIABLE status OUTPUT_VARIABLE disk_output ERROR_VARIABLE errors TIMEOUT 15)
if("${status}" STREQUAL "0")
    string(JSON count LENGTH "${disk_output}")
    string(JSON latency GET "${disk_output}" "disk:512" latency value)
    string(JSON rate GET "${disk_output}" "disk:512" throughput value)
    if(NOT count EQUAL 1 OR latency LESS_EQUAL 0 OR rate LESS_EQUAL 0)
        message(FATAL_ERROR "invalid actual disk report: ${disk_output}")
    endif()
else()
    if(NOT "${disk_output}" STREQUAL "" OR NOT errors MATCHES "io_uring_setup|io_uring unavailable at build time|Operation not supported")
        message(FATAL_ERROR "unexpected disk failure: ${status} ${errors} ${disk_output}")
    endif()
    message(STATUS "Disk unavailable; verified nonzero exit/empty stdout, not successful disk measurement: ${errors}")
endif()
set(trace_root "${work}/tracefs")
file(MAKE_DIRECTORY "${trace_root}/events/block/a" "${trace_root}/events/block/b")
file(WRITE "${trace_root}/events/block/a/enable" "0\n")
file(WRITE "${trace_root}/events/block/b/enable" "1\n")
file(WRITE "${trace_root}/tracing_on" "0\n")
execute_process(COMMAND "${PROGRAM}" disk --dir "${work}" -b512 -s512 --timeout 5000 --trace=block --tracefs "${trace_root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE trace_output ERROR_VARIABLE errors TIMEOUT 15)
if("${status}" STREQUAL "0")
    string(JSON count LENGTH "${trace_output}")
    string(JSON rate GET "${trace_output}" "disk:512" throughput value)
    if(NOT count EQUAL 1 OR rate LESS_EQUAL 0)
        message(FATAL_ERROR "invalid traced disk report: ${trace_output}")
    endif()
elseif(NOT "${trace_output}" STREQUAL "" OR NOT errors MATCHES "io_uring_setup|io_uring unavailable at build time|Operation not supported")
    message(FATAL_ERROR "unexpected traced-disk failure: ${status} ${errors}")
endif()
file(READ "${trace_root}/events/block/a/enable" event_a)
file(READ "${trace_root}/events/block/b/enable" event_b)
file(READ "${trace_root}/tracing_on" tracing)
if(NOT "${event_a}" STREQUAL "0\n" OR NOT "${event_b}" STREQUAL "1\n" OR NOT "${tracing}" STREQUAL "0\n")
    message(FATAL_ERROR "tracefs event/tracing states not restored")
endif()
file(REMOVE_RECURSE "${trace_root}")
file(READ "${work}/preserved" preserved)
file(GLOB leftovers "${work}/*")
list(LENGTH leftovers count)
if(NOT "${preserved}" STREQUAL "unrelated data" OR NOT count EQUAL 1)
    message(FATAL_ERROR "benchmark failed to preserve unrelated data/clean temporary files")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Real submit and native write JSON validated; invalid commands produced no measurements")
