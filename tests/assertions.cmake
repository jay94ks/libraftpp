if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()
execute_process(COMMAND "${PROGRAM}" --info RESULT_VARIABLE info_status
    OUTPUT_VARIABLE info ERROR_VARIABLE info_error TIMEOUT 5)
string(STRIP "${info}" info)
if(NOT info_status STREQUAL "0" OR NOT info MATCHES "^active=([01]) backtrace=([01])$")
    message(FATAL_ERROR "Invalid assertion probe: ${info_status}: ${info} ${info_error}")
endif()
set(active "${CMAKE_MATCH_1}")
set(backtrace "${CMAKE_MATCH_2}")
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(active)
    if(NOT status MATCHES "[Aa]bort" OR NOT error MATCHES "minimum <= maximum"
       OR NOT error MATCHES "random.cpp")
        message(FATAL_ERROR "Expected library assertion abort (${info}): ${status}\n${output}${error}")
    endif()
    string(REGEX MATCHALL "#[0-9]+ 0x[0-9a-fA-F]+" frames "${error}")
    list(LENGTH frames frame_count)
    if(backtrace)
        if(NOT error MATCHES "backtrace:" OR frame_count LESS 2)
            message(FATAL_ERROR "Missing assertion frames: ${error}")
        endif()
    elseif(error MATCHES "backtrace:" OR frame_count GREATER 0)
        message(FATAL_ERROR "Backtrace emitted with the option OFF: ${error}")
    endif()
    message(STATUS "${info}: library aborted as expected, frames=${frame_count}\n${error}")
elseif(NOT status STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "NDEBUG library assertion must be disabled: ${status}\n${output}${error}")
else()
    message(STATUS "${info}: NDEBUG library assertion disabled")
endif()
