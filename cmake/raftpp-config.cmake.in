@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(raftpp_AVAILABLE_COMPONENTS "@RAFTPP_AVAILABLE_COMPONENTS@")
set(raftpp_RESOLVED_COMPONENTS core)
if(raftpp_FIND_COMPONENTS)
    foreach(component IN LISTS raftpp_FIND_COMPONENTS)
        if(component IN_LIST raftpp_AVAILABLE_COMPONENTS)
            set(raftpp_${component}_FOUND TRUE)
            list(APPEND raftpp_RESOLVED_COMPONENTS "${component}")
        else()
            set(raftpp_${component}_FOUND FALSE)
            if(raftpp_FIND_REQUIRED_${component})
                set(raftpp_FOUND FALSE)
                set(raftpp_NOT_FOUND_MESSAGE "raftpp was built without component '${component}'")
                return()
            endif()
        endif()
    endforeach()
else()
    set(raftpp_RESOLVED_COMPONENTS "${raftpp_AVAILABLE_COMPONENTS}")
endif()
if("bindings" IN_LIST raftpp_RESOLVED_COMPONENTS)
    list(APPEND raftpp_RESOLVED_COMPONENTS @RAFTPP_BINDINGS_COMPONENTS@)
endif()
if("uv" IN_LIST raftpp_RESOLVED_COMPONENTS AND @RAFTPP_PACKAGE_UV_NEEDS_LZ4_MODULE@)
    list(APPEND raftpp_RESOLVED_COMPONENTS lz4)
endif()
list(REMOVE_DUPLICATES raftpp_RESOLVED_COMPONENTS)
set(_raftpp_uv FALSE)
set(_raftpp_lz4 FALSE)
if("uv" IN_LIST raftpp_RESOLVED_COMPONENTS)
    set(_raftpp_uv @RAFTPP_PACKAGE_NEEDS_UV@)
    set(_raftpp_lz4 @RAFTPP_PACKAGE_NEEDS_LZ4@)
endif()
if(_raftpp_uv OR _raftpp_lz4)
    find_dependency(PkgConfig)
endif()
if(_raftpp_uv)
    pkg_check_modules(RAFTPP_UV QUIET IMPORTED_TARGET "libuv>=1.18.0")
    if(NOT RAFTPP_UV_FOUND)
        set(raftpp_FOUND FALSE)
        set(raftpp_NOT_FOUND_MESSAGE "raftpp requires libuv>=1.18.0")
        return()
    endif()
endif()
if(_raftpp_lz4)
    pkg_check_modules(RAFTPP_LZ4 QUIET IMPORTED_TARGET "liblz4>=1.7.1")
    if(NOT RAFTPP_LZ4_FOUND)
        set(raftpp_FOUND FALSE)
        set(raftpp_NOT_FOUND_MESSAGE "static raftpp requires liblz4>=1.7.1")
        return()
    endif()
endif()
if(@RAFTPP_PACKAGE_NEEDS_BACKTRACE@ AND NOT TARGET raftpp::backtrace)
    find_library(raftpp_BACKTRACE_LIBRARY backtrace HINTS ${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES})
    if(NOT raftpp_BACKTRACE_LIBRARY OR NOT EXISTS "${raftpp_BACKTRACE_LIBRARY}")
        set(raftpp_FOUND FALSE)
        set(raftpp_NOT_FOUND_MESSAGE "static raftpp requires GNU libbacktrace")
        return()
    endif()
    add_library(raftpp::backtrace UNKNOWN IMPORTED)
    set_target_properties(raftpp::backtrace PROPERTIES
        IMPORTED_LOCATION "${raftpp_BACKTRACE_LIBRARY}"
        INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}")
endif()

@RAFTPP_PACKAGE_DEPENDENCIES@

include("${CMAKE_CURRENT_LIST_DIR}/raftpp-targets.cmake")
check_required_components(raftpp)
