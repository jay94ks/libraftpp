# Builds only the required native libraries in a disposable copy of the checkout.
foreach(required IN ITEMS RAFTPP_SDK_NAME RAFTPP_SDK_SOURCE RAFTPP_SDK_WORK RAFTPP_SDK_PREFIX)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
find_program(make NAMES gmake make REQUIRED)
function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${RAFTPP_SDK_WORK}"
        RESULT_VARIABLE result COMMAND_ECHO STDOUT)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${RAFTPP_SDK_NAME} build failed (${result})")
    endif()
endfunction()
find_program(git NAMES git REQUIRED)
execute_process(COMMAND "${git}" -C "${RAFTPP_SDK_SOURCE}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0)
    message(FATAL_ERROR "Cannot identify the pinned ${RAFTPP_SDK_NAME} source")
endif()
string(SHA256 input_hash
    "${RAFTPP_SDK_SOURCE};${revision};${RAFTPP_SDK_PREFIX};${RAFTPP_SDK_SHARED};$ENV{CC};$ENV{CXX};$ENV{CFLAGS};$ENV{CXXFLAGS};$ENV{LDFLAGS};$ENV{AR};$ENV{RANLIB}")
set(previous_hash "")
if(EXISTS "${RAFTPP_SDK_WORK}/.raftpp-source-ready")
    file(READ "${RAFTPP_SDK_WORK}/.raftpp-source-ready" previous_hash)
endif()
if(NOT previous_hash STREQUAL input_hash)
    # Only this recipe's disposable work tree is replaced, never its checkout.
    file(REMOVE_RECURSE "${RAFTPP_SDK_WORK}")
    file(MAKE_DIRECTORY "${RAFTPP_SDK_WORK}")
    file(COPY "${RAFTPP_SDK_SOURCE}/" DESTINATION "${RAFTPP_SDK_WORK}"
        PATTERN .git EXCLUDE)
    file(WRITE "${RAFTPP_SDK_WORK}/.raftpp-source-ready" "${input_hash}")
endif()
if(RAFTPP_SDK_NAME STREQUAL "boost")
    if(NOT EXISTS "${RAFTPP_SDK_WORK}/tools/build/src/engine/build.sh")
        message(FATAL_ERROR "Initialize Boost's source submodules before preparing its SDK")
    endif()
    if(NOT EXISTS "${RAFTPP_SDK_WORK}/b2")
        run(sh ./bootstrap.sh --with-libraries=context,regex)
    endif()
    if(RAFTPP_SDK_SHARED)
        set(link shared)
    else()
        set(link static)
    endif()
    run("${RAFTPP_SDK_WORK}/b2" "-j${RAFTPP_SDK_JOBS}" --with-context --with-regex
        variant=release "link=${link}" threading=multi cxxflags=-fPIC
        "--prefix=${RAFTPP_SDK_PREFIX}" --layout=system install)
elseif(RAFTPP_SDK_NAME STREQUAL "libsodium")
    if(NOT EXISTS "${RAFTPP_SDK_WORK}/configure")
        run(sh ./autogen.sh -b -s)
    endif()
    if(NOT EXISTS "${RAFTPP_SDK_WORK}/Makefile")
        if(RAFTPP_SDK_SHARED)
            set(link --enable-shared --disable-static)
        else()
            set(link --disable-shared --enable-static)
        endif()
        run(sh ./configure "--prefix=${RAFTPP_SDK_PREFIX}" --with-pic
            --disable-dependency-tracking ${link})
    endif()
    run("${make}" "-j${RAFTPP_SDK_JOBS}")
    run("${make}" install)
elseif(RAFTPP_SDK_NAME STREQUAL "openssl")
    find_program(perl NAMES perl REQUIRED)
    if(NOT EXISTS "${RAFTPP_SDK_WORK}/Makefile")
        if(RAFTPP_SDK_SHARED)
            set(link shared)
        else()
            set(link no-shared)
        endif()
        run("${perl}" ./Configure "--prefix=${RAFTPP_SDK_PREFIX}" --libdir=lib
            ${link} no-tests no-apps no-module)
    endif()
    run("${make}" "-j${RAFTPP_SDK_JOBS}" build_libs)
    run("${make}" install_dev)
else()
    message(FATAL_ERROR "Unsupported POSIX SDK ${RAFTPP_SDK_NAME}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/install-sdk-licenses.cmake")
